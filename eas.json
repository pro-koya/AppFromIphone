{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true
      }
    },
    "testflight": {
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "testflight"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "kouya114@outlook.jp",
        "ascAppId": "6761009357"
      }
    }
  }
}
